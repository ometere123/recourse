{
  "name": "recourse",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run verify:frontend && npm run verify:contract",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "verify:prefilter": "node scripts/verify-prefilter.mjs",
    "verify:embedded": "node scripts/run-python.mjs scripts/verify_embedded_prefilter.py",
    "verify:frontend": "node --experimental-strip-types --test tests/frontend/*.test.ts",
    "verify:contract": "node scripts/run-python.mjs -m pytest tests/direct -q",
    "verify:deployment": "node scripts/verify-deployment-source.mjs",
    "verify:schema": "node scripts/verify-schema.mjs",
    "verify:studionet": "node scripts/exercise-studionet.mjs",
    "verify": "npm run verify:fixtures && npm run verify:prefilter && npm run verify:embedded && npm run verify:frontend && npm run verify:contract && npm run verify:deployment && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "lucide-react": "^1.27.0",
    "next": "16.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

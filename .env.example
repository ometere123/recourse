# Deployed Recourse Intelligent Contract address. Leave unset to run the frontend
# against the on-disk fixture set (real OFAC rows, no network) instead of a chain.
NEXT_PUBLIC_RECOURSE_CONTRACT=0xA73d81f1f7Cf772AC5976317eE12D259a67D48F7

# GenLayer JSON-RPC endpoint and chain. Defaults below are StudioNet.
NEXT_PUBLIC_GENLAYER_ENDPOINT=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN=studionet
